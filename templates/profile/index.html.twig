{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="page-header">
    <h1>Mon profil</h1>
    <div>
        <a class="btn btn-secondary" href="{{ path('app_logout') }}">Se déconnecter</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-secondary" href="{{ path('app_book_index') }}">Administration</a>
        {% endif %}
    </div>
</div>

    {% if not app.user %}
        <div class="card">
            <p class="muted">Vous n'êtes pas connecté.</p>
            <a class="btn btn-primary" href="{{ path('app_login') }}">Se connecter</a>
        </div>
    {% else %}
        <div class="card">
            <div class="form-row">
                <div class="form-group">
                    <div class="muted" style="font-weight: 700; margin-bottom: 6px;">Email</div>
                    <div style="font-weight: 800;">{{ app.user.userIdentifier }}</div>
                </div>
                <div class="form-group">
                    <div class="muted" style="font-weight: 700; margin-bottom: 6px;">Rôles</div>
                    <div>
                        {% for role in app.user.roles %}
                            <span class="badge">{{ role }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <h2 style="margin: 14px 0 8px; font-size: 1.1rem;">Mes discussions</h2>
            {% if app.user.discussions is defined and app.user.discussions|length > 0 %}
                <ul>
                    {% for discussion in app.user.discussions %}
                        <li>
                            <strong>{{ discussion.title }}</strong>
                            <span class="muted">— sur « {{ discussion.book.name }} »</span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="muted">Vous n'avez pas encore créé de discussion.</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
