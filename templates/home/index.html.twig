{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}!</h1>

    <div class="user-info">
        {% if app.user %}
            <p>Connecté en tant que : <strong>{{ app.user.userIdentifier }}</strong></p>
            
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_book_index') }}" class="btn">Accéder à l'administration</a>
            {% endif %}
            
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_profile') }}" class="btn">Mon profil</a>
            {% endif %}
            
            <a href="{{ path('app_logout') }}" class="btn btn-logout">Se déconnecter</a>
        {% else %}
            <p>🔒 Vous n'êtes pas connecté</p>
            <a href="{{ path('app_login') }}" class="btn">Se connecter</a>
        {% endif %}
    </div>

</div>
{% endblock %}
